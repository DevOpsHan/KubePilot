# 可选:仅远程部署/自定义时需要。开箱即用可跳过本文件,直接 `docker compose up --build -d`。
# 需要覆盖时:复制本文件为 .env,docker compose 会自动读取。

# 可选:留空时首次启动会自动生成长度为 32 字节的随机文本密钥并保存到兼容卷 backend-data。
# 显式设置后必须正好为 32 个 UTF-8 字节;一旦保存数据后不得更换。
AIOPS_SECRET_KEY=
AIOPS_SYNC_ENABLED=true

AIOPS_DB_NAME=aiops
AIOPS_DB_USER=aiops
AIOPS_DB_PASSWORD=change-me-db-password
AIOPS_DB_ROOT_PASSWORD=change-me-root-password

# KubePilot Console 默认仅允许本机访问。变量名为兼容已有部署继续保留 FRONTEND。
# 远程部署时显式改为 0.0.0.0，并配置防火墙与 HTTPS 反向代理。
AIOPS_FRONTEND_BIND_ADDRESS=127.0.0.1
AIOPS_FRONTEND_PORT=5174
